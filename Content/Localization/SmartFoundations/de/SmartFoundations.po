msgstr "X/Y/Z-Achsenbeschriftungen auf den Richtungspfeilen anzeigen."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(163)
msgctxt "SmartFoundations,P.bShowArrowOrbit"
msgid "Arrow Orbit Animation"
msgstr "Pfeil-Orbit-Animation"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(164)
msgctxt "SmartFoundations,P.bShowArrowOrbit.TT"
msgid "Animate the arrows orbiting the hologram. Turn off for static arrows that still track you."
msgstr "Die Pfeile um das Hologramm kreisen lassen. Ausschalten für statische Pfeile, die dir dennoch folgen."

