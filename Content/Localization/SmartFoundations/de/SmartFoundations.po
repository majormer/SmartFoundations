msgctxt "SmartFoundations,P.bShowHUD"
msgid "Show HUD Overlay"
msgstr "HUD-Anzeige"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(147)
msgctxt "SmartFoundations,P.bShowHUD.TT"
msgid "Show the Smart! overlay (grid, scale, and recipe info) while building."
msgstr "Die Smart!-Anzeige (Raster-, Skalierungs- und Rezeptinfo) während des Bauens anzeigen."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(38)
