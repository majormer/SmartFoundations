msgstr "設置したサポートの間でハイパーチューブを自動接続します。"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(45)
msgctxt "SmartFoundations,P.bPipeAutoConnectEnabled"
msgid "Pipe Auto-Connect"
msgstr "パイプ自動接続"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(46)
msgctxt "SmartFoundations,P.bPipeAutoConnectEnabled.TT"
