#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(116)
msgctxt "SmartFoundations,P.bExtendDaisyChainPoleless.TT"
msgid "When you Extend a factory that has no power pole and no existing daisy link (starting a fresh manifold), wire the new buildings together with daisy-chain power. Factories already daisy-chained are always continued regardless of this option."
msgstr "Lorsque vous étendez une usine sans poteau électrique et sans lien de chaînage existant (démarrage d'un nouveau collecteur), câblez les nouveaux bâtiments ensemble par chaînage électrique. Les usines déjà chaînées sont toujours poursuivies, quelle que soit cette option."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(113)
msgctxt "SmartFoundations,P.bExtendDaisyChainPower"
msgid "Extend Daisy-Chain Power"
msgstr "Étendre le chaînage électrique"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(114)
msgctxt "SmartFoundations,P.bExtendDaisyChainPower.TT"
msgid "Once Upgraded Power Connectors is unlocked, Extend wires power directly building-to-building along the lane instead of running a pole to each building."
msgstr "Une fois les Connecteurs d’alimentation améliorés débloqués, l'option Étendre câble l'énergie directement de bâtiment à bâtiment le long de la rangée au lieu d'amener un poteau à chaque bâtiment."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(109)
msgctxt "SmartFoundations,P.bExtendEnabled"
msgid "Extend Enabled"
msgstr "Extension activée"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(110)
msgctxt "SmartFoundations,P.bExtendEnabled.TT"
msgid "Enable Extend - repeat a building or grid outward in one direction."
msgstr "Activer l'Extension — répéter un bâtiment ou une grille vers l'extérieur dans une direction."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(111)
msgctxt "SmartFoundations,P.bExtendPowerEnabled"
msgid "Extend Power Poles"
msgstr "Étendre les poteaux électriques"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(112)
msgctxt "SmartFoundations,P.bExtendPowerEnabled.TT"
msgid "Include power poles when using Extend."
msgstr "Inclure les poteaux électriques lors de l'utilisation de l'Extension."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(60)
msgctxt "SmartFoundations,P.bHypertubeAutoConnectEnabled"
msgid "Hypertube Auto-Connect"
msgstr "Connexion auto Hypertube"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(61)
msgctxt "SmartFoundations,P.bHypertubeAutoConnectEnabled.TT"
msgid "Automatically connect hypertubes between placed supports."
msgstr "Connecter automatiquement les Hypertubes entre les supports placés."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(45)
msgctxt "SmartFoundations,P.bPipeAutoConnectEnabled"
msgid "Pipe Auto-Connect"
msgstr "Connexion auto tuyaux"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(46)
msgctxt "SmartFoundations,P.bPipeAutoConnectEnabled.TT"
msgid "Automatically connect pipes between placed buildings."
msgstr "Connecter automatiquement les tuyaux entre les bâtiments placés."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(122)
msgctxt "SmartFoundations,P.bPlayerRelativeControls"
msgid "Player Relative Controls"
msgstr "Contrôles relatifs au joueur"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(123)
msgctxt "SmartFoundations,P.bPlayerRelativeControls.TT"
msgid "Interpret building controls relative to the direction you are facing. The Smart Panel continues to show absolute axes."
msgstr "Interpréter les contrôles de construction par rapport à la direction dans laquelle vous regardez. Le Panneau Smart continue d'afficher les axes absolus."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(69)
msgctxt "SmartFoundations,P.bPowerAutoConnectEnabled"
msgid "Power Auto-Connect"
msgstr "Connexion auto énergie"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(70)
msgctxt "SmartFoundations,P.bPowerAutoConnectEnabled.TT"
msgid "Automatically wire power between placed buildings and nearby power poles."
msgstr "Câbler automatiquement l'énergie entre les bâtiments placés et les poteaux électriques proches."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(107)
msgctxt "SmartFoundations,P.bPreserveUpgradeDismantleGroups"
msgid "Preserve Upgrade Dismantle Groups"
msgstr "Préserver les groupes de démantèlement d'amélioration"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(108)
msgctxt "SmartFoundations,P.bPreserveUpgradeDismantleGroups.TT"
msgid "Default for preserving existing dismantle-group membership during Smart upgrades and supported downgrades. Can be overridden in the Upgrade panel."
msgstr "Par défaut pour préserver l'appartenance aux groupes de démontage existants lors des améliorations Smart et des rétrogradations prises en charge. Peut être remplacé dans le panneau d'amélioration."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(71)
msgctxt "SmartFoundations,P.bScaleDaisyChainPower"
msgid "Scale Daisy-Chain Power"
msgstr "Chaîner l'énergie à la mise à l'échelle"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(72)
msgctxt "SmartFoundations,P.bScaleDaisyChainPower.TT"
msgid "When Upgraded Power Connectors is unlocked, scaling factories and generators wires adjacent buildings together along the grid X axis."
msgstr "Une fois les Connecteurs d’alimentation améliorés débloqués, la mise à l'échelle des usines et des générateurs relie les bâtiments adjacents le long de l'axe X de la grille."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(165)
msgctxt "SmartFoundations,P.bShowArrowLabels"
msgid "Arrow Axis Labels"
msgstr "Étiquettes d'axes des flèches"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(166)
msgctxt "SmartFoundations,P.bShowArrowLabels.TT"
msgid "Show X/Y/Z axis labels on the direction arrows."
msgstr "Afficher les étiquettes d'axe X/Y/Z sur les flèches directionnelles."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(163)
msgctxt "SmartFoundations,P.bShowArrowOrbit"
msgid "Arrow Orbit Animation"
msgstr "Animation orbite des flèches"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(164)
msgctxt "SmartFoundations,P.bShowArrowOrbit.TT"
msgid "Animate the arrows orbiting the hologram. Turn off for static arrows that still track you."
msgstr "Animer les flèches en orbite autour de l'hologramme. Désactivez pour des flèches statiques qui vous suivent toujours."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(161)
msgctxt "SmartFoundations,P.bShowArrows"
msgid "Show Direction Arrows"
msgstr "Afficher les flèches directionnelles"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(162)
msgctxt "SmartFoundations,P.bShowArrows.TT"
msgid "Show X/Y/Z direction arrows on the building hologram."
msgstr "Afficher les flèches directionnelles X/Y/Z sur l'hologramme du bâtiment."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(146)
msgctxt "SmartFoundations,P.bShowHUD"
msgid "Show HUD Overlay"
msgstr "Afficher le HUD"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(147)
msgctxt "SmartFoundations,P.bShowHUD.TT"
msgid "Show the Smart! overlay (grid, scale, and recipe info) while building."
msgstr "Afficher l'overlay Smart! (grille, échelle et infos de recette) pendant la construction."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(38)
msgctxt "SmartFoundations,P.bStackableBeltEnabled"
msgid "Stackable Belt Auto-Connect"
msgstr "Connexion auto empilable"

