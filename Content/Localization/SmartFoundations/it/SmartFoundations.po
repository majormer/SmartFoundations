msgstr "Come vengono modellate le condutture collegate automaticamente: Auto, 2D, Dritto, Curva, Noodle o Orizzontale-Verticale."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_1.BP_ConfigPropertyBool_C_0.Tooltip
msgctxt "SmartFoundationsConfig,root/PipeAutoConnect/bPipeAutoConnectEnabled/tooltip"
msgid "Automatically connect pipes between placed buildings."
msgstr "Collega automaticamente le condutture tra gli edifici posizionati."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_1.HeaderText
msgctxt "SmartFoundationsConfig,root/PipeAutoConnect/header_text"
msgid "Pipe Auto-Connect"
msgstr "Auto-connessione condutture"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_1.Tooltip
msgctxt "SmartFoundationsConfig,root/PipeAutoConnect/tooltip"
msgid "Automatically run pipes between the buildings you place."
msgstr "Collega automaticamente le condutture tra gli edifici che posizioni."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_2.BP_ConfigPropertyInteger_C_0.Tooltip
msgctxt "SmartFoundationsConfig,root/PowerAutoConnect/PowerConnectMode/tooltip"
msgid "Which directions power poles connect: Auto, X only, Y only, or both X and Y."
msgstr "Direzioni di connessione dei pali elettrici: Auto, solo X, solo Y o entrambi X e Y."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_2.BP_ConfigPropertyInteger_C_1.Tooltip
