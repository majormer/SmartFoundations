msgstr "Quando sono sbloccati i Connettori di alimentazione potenziati, la scalatura di fabbriche o generatori collega automaticamente gli edifici adiacenti lungo l'asse X della griglia."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_2.HeaderText
msgctxt "SmartFoundationsConfig,root/PowerAutoConnect/header_text"
msgid "Power Auto-Connect"
msgstr "Auto-connessione energia"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_2.Tooltip
msgctxt "SmartFoundationsConfig,root/PowerAutoConnect/tooltip"
msgid "Automatically wire power between buildings and power poles as you build."
msgstr "Collega automaticamente l'energia tra edifici e pali elettrici mentre costruisci."

