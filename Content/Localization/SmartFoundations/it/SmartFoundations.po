msgctxt "SmartFoundationsConfig,root/PowerAutoConnect/PowerConnectReserved/tooltip"
msgid "Number of pole connection slots to leave free for your own manual wiring."
msgstr "Numero di slot di connessione dei pali da lasciare liberi per il cablaggio manuale."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_2.BP_ConfigPropertyBool_C_0.Tooltip
msgctxt "SmartFoundationsConfig,root/PowerAutoConnect/bPowerAutoConnectEnabled/tooltip"
msgid "Automatically wire power between placed buildings and nearby power poles."
msgstr "Collega automaticamente l'energia tra gli edifici posizionati e i pali elettrici vicini."

