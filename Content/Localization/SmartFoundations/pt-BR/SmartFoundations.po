#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_6.BP_ConfigPropertyBool_C_0.Tooltip
msgctxt "SmartFoundationsConfig,root/HypertubeAutoConnect/bHypertubeAutoConnectEnabled/tooltip"
