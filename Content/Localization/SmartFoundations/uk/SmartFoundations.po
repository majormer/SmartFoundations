#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_5.BP_ConfigPropertyBool_C_2.Tooltip
msgctxt "SmartFoundationsConfig,root/Arrows/bShowArrowLabels/tooltip"
msgid "Show X/Y/Z axis labels on the direction arrows."
msgstr "Показувати мітки осей X/Y/Z на стрілках напрямку."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_5.BP_ConfigPropertyBool_C_1.Tooltip
msgctxt "SmartFoundationsConfig,root/Arrows/bShowArrowOrbit/tooltip"
msgid "Animate the arrows orbiting the hologram. Turn off for static arrows that still track you."
msgstr "Анімувати обертання стрілок навколо голограми. Вимкніть для статичних стрілок, які все одно стежать за вами."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_5.BP_ConfigPropertyBool_C_0.Tooltip
msgctxt "SmartFoundationsConfig,root/Arrows/bShowArrows/tooltip"
msgid "Show X/Y/Z direction arrows on the building hologram."
msgstr "Показувати стрілки напрямку X/Y/Z на голограмі будівлі."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_5.HeaderText
msgctxt "SmartFoundationsConfig,root/Arrows/header_text"
msgid "Arrows"
msgstr "Стрілки"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_5.Tooltip
msgctxt "SmartFoundationsConfig,root/Arrows/tooltip"
msgid "Directional arrows drawn on the building hologram."
msgstr "Стрілки напрямку, намальовані на голограмі будівлі."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.AutoConnectBehavior.NearbyLogisticsRange.DisplayName
msgctxt "SmartFoundationsConfig,root/AutoConnectBehavior/NearbyLogisticsRange/display_name"
msgid "Nearby Logistics Range (m):"
msgstr "Діапазон сусідньої логістики (м):"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.AutoConnectBehavior.NearbyLogisticsRange.Tooltip
msgctxt "SmartFoundationsConfig,root/AutoConnectBehavior/NearbyLogisticsRange/tooltip"
msgid "Maximum connector-to-connector distance for nearby factory belt and pipe Auto-Connect. Blueprint seams and manifold lanes are unaffected."
msgstr "Максимальна відстань між конекторами для автоз'єднання стрічок і труб ближніх фабрик. Шви креслень і лінії колекторів не зачіпаються."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.AutoConnectBehavior.HeaderText
msgctxt "SmartFoundationsConfig,root/AutoConnectBehavior/header_text"
msgid "Auto-Connect Behavior"
msgstr "Поведінка автоз'єднання"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.AutoConnectBehavior.Tooltip
msgctxt "SmartFoundationsConfig,root/AutoConnectBehavior/tooltip"
msgid "Controls behavior shared by nearby belt and pipe Auto-Connect."
msgstr "Керує поведінкою, спільною для автоз'єднання ближніх стрічок і труб."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_0.BP_ConfigPropertyInteger_C_0.Tooltip
msgctxt "SmartFoundationsConfig,root/BeltAutoConnect/BeltLevelMain/tooltip"
msgid "Belt tier for distributor-to-distributor (manifold) connections. Auto uses the highest tier you've unlocked."
msgstr "Рівень стрічки для з'єднань розподільник-розподільник (колектор). Авто використовує найвищий розблокований рівень."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_0.BP_ConfigPropertyInteger_C_1.Tooltip
msgctxt "SmartFoundationsConfig,root/BeltAutoConnect/BeltLevelToBuilding/tooltip"
msgid "Belt tier for distributor-to-building connections. Auto uses the highest tier you've unlocked."
msgstr "Рівень стрічки для з'єднань розподільник-будівля. Авто використовує найвищий розблокований рівень."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_0.BP_ConfigPropertyInteger_C_2.Tooltip
msgctxt "SmartFoundationsConfig,root/BeltAutoConnect/BeltRoutingMode/tooltip"
msgid "How auto-connected belts are shaped: Default, Curve, or Straight."
msgstr "Форма авто-з'єднаних стрічок: За замовчуванням, Крива або Пряма."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_0.LiftUsageMode.DisplayName
msgctxt "SmartFoundationsConfig,root/BeltAutoConnect/LiftUsageMode/display_name"
msgid "Factory Connection"
msgstr "Підключення до виробництва"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_0.LiftUsageMode.Tooltip
msgctxt "SmartFoundationsConfig,root/BeltAutoConnect/LiftUsageMode/tooltip"
msgid "Belts Only keeps ordinary belt routing. Lift at Distributor keeps the belt at machine height; Lift at Building keeps it at distributor height. Native costs and placement restrictions apply."
msgstr "Режим 'Лише стрічки' зберігає звичайну маршрутизацію стрічок. Режим 'Підіймач на розгалужувачі' тримає стрічку на висоті машини; режим 'Підіймач на будівлі' тримає її на висоті розгалужувача. Діють стандартні вартості та обмеження розміщення."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_0.BP_ConfigPropertyBool_C_1.Tooltip
msgctxt "SmartFoundationsConfig,root/BeltAutoConnect/bAutoConnectDistributors/tooltip"
msgid "Chain distributors together with manifold lane belts, so a whole row is fed from one input."
msgstr "З'єднувати розподільники в ланцюг стрічками колектора, щоб увесь ряд живився з одного входу."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_0.BP_ConfigPropertyBool_C_0.Tooltip
msgctxt "SmartFoundationsConfig,root/BeltAutoConnect/bAutoConnectEnabled/tooltip"
msgid "Automatically connect conveyor belts between placed buildings and distributors."
msgstr "Автоматично з'єднувати конвеєрні стрічки між розміщеними будівлями та розподільниками."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_0.BP_ConfigPropertyBool_C_2.Tooltip
msgctxt "SmartFoundationsConfig,root/BeltAutoConnect/bStackableBeltEnabled/tooltip"
msgid "Allow auto-connected belts to stack vertically where they overlap."
msgstr "Дозволити авто-з'єднаним стрічкам складатися вертикально в місцях перетину."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_0.HeaderText
msgctxt "SmartFoundationsConfig,root/BeltAutoConnect/header_text"
msgid "Belt Auto-Connect"
msgstr "Авто-з'єднання стрічок"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_0.Tooltip
msgctxt "SmartFoundationsConfig,root/BeltAutoConnect/tooltip"
msgid "Automatically run conveyor belts between the buildings you place."
msgstr "Автоматично прокладати конвеєрні стрічки між будівлями, які ви розміщуєте."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BlueprintAutoConnect.bBlueprintSeamAutoConnectEnabled.DisplayName
msgctxt "SmartFoundationsConfig,root/BlueprintAutoConnect/bBlueprintSeamAutoConnectEnabled/display_name"
msgid "Blueprint Seam Auto-Connect:"
msgstr "Автопідключення швів креслень:"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BlueprintAutoConnect.bBlueprintSeamAutoConnectEnabled.Tooltip
msgctxt "SmartFoundationsConfig,root/BlueprintAutoConnect/bBlueprintSeamAutoConnectEnabled/tooltip"
msgid "Connect compatible open belt, pipe, Hypertube, railway and vehicle-path tails between repeated Blueprints. Lift tails can align vertical belt connections. Native direction, length, slope, placement rules and normal material costs apply; unmarked building ports are not connection intent."
msgstr "З'єднувати сумісні відкриті кінці стрічок, труб, гіпертруб, колій та шляхів транспорту між повторюваними проєктами. Кінці конвеєрних підіймачів можуть вирівнювати вертикальні з'єднання стрічок. Діють стандартні правила напрямку, довжини, нахилу, розміщення та звичайні витрати матеріалів; не позначені порти будівель не вважаються наміром з'єднання."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BlueprintAutoConnect.HeaderText
msgctxt "SmartFoundationsConfig,root/BlueprintAutoConnect/header_text"
msgid "Blueprint Auto-Connect"
msgstr "Автоз'єднання проєктів"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BlueprintAutoConnect.Tooltip
msgctxt "SmartFoundationsConfig,root/BlueprintAutoConnect/tooltip"
msgid "Controls connections between adjacent copies of scaled blueprints."
msgstr "Керує з'єднаннями між сусідніми копіями масштабованих проєктів."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BlueprintSpacingX.DisplayName
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/BlueprintSpacingX/display_name"
msgid "Blueprint Default X Spacing (m)"
msgstr "Відстань креслення за замовчуванням X (м)"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BlueprintSpacingX.Tooltip
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/BlueprintSpacingX/tooltip"
msgid "Starting X gap for a new blueprint build session (0-100 m). Zero tiles flush; short gaps may leave no room for seam connections. Panel changes override this for the current session."
msgstr "Початковий зазор по X для нової сесії будівництва за проєктом (0-100 м). Нульове значення розміщує впритул; короткі зазори можуть не залишити місця для з'єднань швів. Зміни в панелі мають пріоритет для поточної сесії."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BlueprintSpacingY.DisplayName
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/BlueprintSpacingY/display_name"
msgid "Blueprint Default Y Spacing (m)"
msgstr "Відстань креслення за замовчуванням Y (м)"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BlueprintSpacingY.Tooltip
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/BlueprintSpacingY/tooltip"
msgid "Starting Y gap for a new blueprint build session (0-100 m). Zero tiles flush; short gaps may leave no room for seam connections. Panel changes override this for the current session."
msgstr "Початковий зазор по Y для нової сесії будівництва за проєктом (0-100 м). Нульове значення розміщує впритул; короткі зазори можуть не залишити місця для з'єднань швів. Зміни в панелі мають пріоритет для поточної сесії."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BlueprintSpacingZ.DisplayName
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/BlueprintSpacingZ/display_name"
msgid "Blueprint Default Z Spacing (m)"
msgstr "Відстань креслення за замовчуванням Z (м)"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BlueprintSpacingZ.Tooltip
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/BlueprintSpacingZ/tooltip"
msgid "Starting Z gap for a new blueprint build session (0-100 m). Zero tiles flush; short gaps may leave no room for seam connections. Panel changes override this for the current session."
msgstr "Початковий зазор по Z для нової сесії будівництва за проєктом (0-100 м). Нульове значення розміщує впритул; короткі зазори можуть не залишити місця для з'єднань швів. Зміни в панелі мають пріоритет для поточної сесії."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.ScalingSettings.RotationIncrement.DisplayName
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/RotationIncrement/display_name"
msgid "Rotation Increment (deg)"
msgstr "Крок обертання (°)"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.ScalingSettings.RotationIncrement.Tooltip
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/RotationIncrement/tooltip"
msgid "Degrees of rotation added per scroll notch (also walk segment turn)."
msgstr "Градуси обертання, що додаються за одну прокрутку (також поворот сегмента ходьби)."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.ScalingSettings.SpacingIncrement.DisplayName
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/SpacingIncrement/display_name"
msgid "Spacing Increment (m)"
msgstr "Крок відстані (м)"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.ScalingSettings.SpacingIncrement.Tooltip
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/SpacingIncrement/tooltip"
msgid "Meters of spacing added per scroll notch (also Extend spacing and walk segment advance)."
msgstr "Метри відстані, що додаються за одну прокрутку (також відстань Розширення та крок сегмента ходьби)."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.ScalingSettings.StaggerIncrement.DisplayName
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/StaggerIncrement/display_name"
msgid "Stagger Increment (m)"
msgstr "Крок зміщення (м)"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.ScalingSettings.StaggerIncrement.Tooltip
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/StaggerIncrement/tooltip"
msgid "Meters of stagger added per scroll notch (also walk segment shift)."
msgstr "Метри зміщення, що додаються за одну прокрутку (також зсув сегмента ходьби)."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.ScalingSettings.StepsIncrement.DisplayName
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/StepsIncrement/display_name"
msgid "Steps Increment (m)"
msgstr "Крок сходинок (м)"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.ScalingSettings.StepsIncrement.Tooltip
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/StepsIncrement/tooltip"
msgid "Meters of stepping added per scroll notch (also walk segment rise)."
msgstr "Метри висотного зміщення, що додаються за одну поділку коліщатка (також підйом сегмента ходьби)."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BP_ConfigPropertyBool_C_3.Tooltip
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/bApplyImmediately/tooltip"
msgid "Apply Smart Panel changes instantly instead of clicking the Apply button."
msgstr "Застосовувати зміни Smart Панелі миттєво замість натискання кнопки Застосувати."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BP_ConfigPropertyBool_C_2.Tooltip
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/bAutoHoldOnGridChange/tooltip"
msgid "Automatically lock the hologram in place after any grid change. Press the Hold key to release it."
msgstr "Автоматично фіксувати голограму на місці після будь-якої зміни сітки. Натисніть клавішу Утримання, щоб відпустити."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BP_ConfigPropertyBool_C_Poleless.DisplayName
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/bExtendDaisyChainPoleless/display_name"
msgid "Daisy-Chain Pole-less Factories:"
msgstr "Ланцюгове розширення заводів без опор:"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BP_ConfigPropertyBool_C_Poleless.Tooltip
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/bExtendDaisyChainPoleless/tooltip"
msgid "When you Extend a factory that has no power pole and no existing daisy link (starting a fresh manifold), wire the new buildings together with daisy-chain power. Factories already daisy-chained are always continued regardless of this option."
msgstr "Коли ви Розширюєте завод без електростовпа і без наявного послідовного зв'язку (починаючи новий колектор), з'єднуйте нові будівлі між собою послідовним живленням. Заводи, які вже з'єднані послідовно, завжди продовжуються незалежно від цього параметра."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BP_ConfigPropertyBool_C_Daisy.DisplayName
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/bExtendDaisyChainPower/display_name"
msgid "Extend Daisy-Chain Power:"
msgstr "Розширення ланцюга живлення:"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BP_ConfigPropertyBool_C_Daisy.Tooltip
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/bExtendDaisyChainPower/tooltip"
msgid "Once Upgraded Power Connectors is unlocked, Extend wires power directly building-to-building along the lane instead of running a pole to each building."
msgstr "Після розблокування дослідження «Поліпшене під’єднання живлення» розширення прокладає електричні з’єднання безпосередньо між будівлями вздовж лінії замість під’єднання кожної будівлі до стовпа."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BP_ConfigPropertyBool_C_0.Tooltip
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/bExtendEnabled/tooltip"
msgid "Enable Extend - repeat a building or grid outward in one direction."
msgstr "Увімкнути Розширення - повторювати будівлю або сітку назовні в одному напрямку."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BP_ConfigPropertyBool_C_1.Tooltip
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/bExtendPowerEnabled/tooltip"
msgid "Include power poles when using Extend."
msgstr "Враховувати електростовпи при використанні Розширення."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BP_ConfigPropertyBool_C_4.DisplayName
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/bPlayerRelativeControls/display_name"
msgid "Player Relative Controls:"
msgstr "Керування відносно гравця:"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BP_ConfigPropertyBool_C_4.Tooltip
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/bPlayerRelativeControls/tooltip"
msgid "Scale and the other transforms follow the direction you're facing while building. The Smart Panel stays fixed X/Y/Z. Off = classic axis controls."
msgstr "Масштабування та інші трансформації слідують за напрямком вашого погляду під час будівництва. Панель Smart залишається фіксованою за осями X/Y/Z. Вимкнено = класичне керування за осями."

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BP_ConfigPropertyBool_C_5.DisplayName
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/bPreserveUpgradeDismantleGroups/display_name"
msgid "Preserve Upgrade Dismantle Groups"
