#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Features/Upgrade/SFUpgradeExecutionService_Miner.cpp(51)
msgctxt "SmartFoundations,Upgrade_MinerInvalidAim"
msgid "The selected Miner has no valid native replacement aim."
msgstr "У вибраного Бурильника немає дійсного стандартного напрямку заміни."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Features/Upgrade/SFUpgradeExecutionService_Miner.cpp(32)
