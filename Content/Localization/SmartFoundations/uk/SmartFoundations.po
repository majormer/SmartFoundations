msgid "The selected Miner is missing its native resource or construction context."
msgstr "У вибраного Бурильника відсутній стандартний контекст ресурсу або будівництва."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Features/Upgrade/SFUpgradeExecutionService_Miner.cpp(95)
