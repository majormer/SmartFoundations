msgstr "Anuluj wybór"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Features/Upgrade/SFUpgradeExecutionService.cpp(600)
msgctxt "SmartFoundations,Upgrade_Cancelled"
msgid "Cancelled by user"
msgstr "Anulowane przez użytkownika"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/UI/SmartUpgradePanel_Detail.cpp(200)
msgctxt "SmartFoundations,Upgrade_CancelledProgress"
msgid "Upgrade cancelled: {0}/{1} completed"
msgstr "Anulowano ulepszanie: ukończono {0}/{1}"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/UI/SmartUpgradePanel.cpp(981)
