#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(130)
msgctxt "SmartFoundations,P.StepsIncrement.TT"
msgid "Meters of stepping added per scroll notch (also walk segment rise)."
msgstr "Zmiana wysokości w metrach na jeden skok kółka myszy (także wznoszenie segmentu trasy)."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(119)
msgctxt "SmartFoundations,P.bApplyImmediately"
msgid "Apply Immediately"
msgstr "Zastosuj natychmiast"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(120)
msgctxt "SmartFoundations,P.bApplyImmediately.TT"
msgid "Apply Smart Panel changes instantly instead of clicking the Apply button."
msgstr "Stosuj zmiany Smart Panel natychmiast zamiast klikać przycisk Zastosuj."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(28)
msgctxt "SmartFoundations,P.bAutoConnectDistributors"
msgid "Use Manifold Lane Belts"
msgstr "Użyj taśm rozdzielacza"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(29)
msgctxt "SmartFoundations,P.bAutoConnectDistributors.TT"
msgid "Chain distributors together with manifold lane belts, so a whole row is fed from one input."
msgstr "Łącz rozdzielacze w łańcuch za pomocą taśm rozdzielacza, aby cały rząd był zasilany z jednego wejścia."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(26)
msgctxt "SmartFoundations,P.bAutoConnectEnabled"
msgid "Belt Auto-Connect"
msgstr "Automatyczne łączenie taśm"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(27)
msgctxt "SmartFoundations,P.bAutoConnectEnabled.TT"
msgid "Automatically connect conveyor belts between placed buildings and distributors."
msgstr "Automatycznie łącz taśmociągi między ustawionymi budynkami a rozdzielaczami."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(117)
msgctxt "SmartFoundations,P.bAutoHoldOnGridChange"
msgid "Auto-Hold on Grid Change"
msgstr "Auto-blokada przy zmianie siatki"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(118)
msgctxt "SmartFoundations,P.bAutoHoldOnGridChange.TT"
msgid "Automatically lock the hologram in place after any grid change. Press the Hold key to release it."
msgstr "Automatycznie blokuj hologram w miejscu po każdej zmianie siatki. Naciśnij klawisz blokady, aby zwolnić."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(85)
msgctxt "SmartFoundations,P.bBlueprintSeamAutoConnectEnabled"
msgid "Blueprint Seam Auto-Connect"
msgstr "Auto-łączenie szwów schematu"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(86)
msgctxt "SmartFoundations,P.bBlueprintSeamAutoConnectEnabled.TT"
msgid "Connect compatible open belt, pipe, Hypertube, railway and vehicle-path tails between repeated Blueprints. Lift tails can align vertical belt connections. Native direction, length, slope, placement rules and normal material costs apply; unmarked building ports are not connection intent."
msgstr "Łączy kompatybilne otwarte końce taśmociągów, rurociągów, Hipertub, szyn kolejowych i ścieżek pojazdów między powtarzanymi Schematami. Końce podnośników mogą wyrównywać pionowe połączenia taśmociągów. Obowiązują natywne kierunki, długości, nachylenia, zasady rozmieszczania i zwykłe koszty materiałów; nieoznaczone porty budynków nie oznaczają intencji połączenia."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(115)
msgctxt "SmartFoundations,P.bExtendDaisyChainPoleless"
msgid "Daisy-Chain Pole-less Factories"
msgstr "Łańcuchowanie fabryk bez słupów"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(116)
msgctxt "SmartFoundations,P.bExtendDaisyChainPoleless.TT"
msgid "When you Extend a factory that has no power pole and no existing daisy link (starting a fresh manifold), wire the new buildings together with daisy-chain power. Factories already daisy-chained are always continued regardless of this option."
msgstr "Gdy rozszerzasz fabrykę, która nie ma słupa energetycznego ani istniejącego połączenia łańcuchowego (rozpoczynając nowy kolektor), połącz nowe budynki zasilaniem łańcuchowym. Fabryki już połączone łańcuchowo są zawsze kontynuowane niezależnie od tej opcji."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(113)
msgctxt "SmartFoundations,P.bExtendDaisyChainPower"
msgid "Extend Daisy-Chain Power"
msgstr "Rozszerzanie zasilania łańcuchowego"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(114)
msgctxt "SmartFoundations,P.bExtendDaisyChainPower.TT"
msgid "Once Upgraded Power Connectors is unlocked, Extend wires power directly building-to-building along the lane instead of running a pole to each building."
msgstr "Po odblokowaniu badania „Ulepszone złącza zasilania” Rozszerzenie łączy budynki bezpośrednio przewodami wzdłuż rzędu, zamiast stawiać słup przy każdym budynku."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(109)
msgctxt "SmartFoundations,P.bExtendEnabled"
msgid "Extend Enabled"
msgstr "Rozszerzanie włączone"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(110)
msgctxt "SmartFoundations,P.bExtendEnabled.TT"
msgid "Enable Extend - repeat a building or grid outward in one direction."
msgstr "Włącz Rozszerzanie - powtarzaj budynek lub siatkę na zewnątrz w jednym kierunku."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(111)
msgctxt "SmartFoundations,P.bExtendPowerEnabled"
msgid "Extend Power Poles"
msgstr "Rozszerzanie słupów"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(112)
msgctxt "SmartFoundations,P.bExtendPowerEnabled.TT"
msgid "Include power poles when using Extend."
msgstr "Uwzględnij słupy energetyczne podczas używania Rozszerzania."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(60)
msgctxt "SmartFoundations,P.bHypertubeAutoConnectEnabled"
msgid "Hypertube Auto-Connect"
msgstr "Automatyczne łączenie hipertub"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(61)
msgctxt "SmartFoundations,P.bHypertubeAutoConnectEnabled.TT"
msgid "Automatically connect hypertubes between placed supports."
msgstr "Automatycznie łącz hipertuby między ustawionymi podporami."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(45)
msgctxt "SmartFoundations,P.bPipeAutoConnectEnabled"
msgid "Pipe Auto-Connect"
msgstr "Automatyczne łączenie rur"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(46)
msgctxt "SmartFoundations,P.bPipeAutoConnectEnabled.TT"
