msgstr "Sterowanie względem gracza"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(123)
msgctxt "SmartFoundations,P.bPlayerRelativeControls.TT"
msgid "Interpret building controls relative to the direction you are facing. The Smart Panel continues to show absolute axes."
msgstr "Interpretuj sterowanie budowaniem względem kierunku, w którym patrzysz. Smart Panel nadal pokazuje osie bezwzględne."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(69)
msgctxt "SmartFoundations,P.bPowerAutoConnectEnabled"
msgid "Power Auto-Connect"
msgstr "Automatyczne łączenie zasilania"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(70)
msgctxt "SmartFoundations,P.bPowerAutoConnectEnabled.TT"
msgid "Automatically wire power between placed buildings and nearby power poles."
msgstr "Automatycznie okablowuj zasilanie między ustawionymi budynkami a pobliskimi słupami energetycznymi."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(107)
