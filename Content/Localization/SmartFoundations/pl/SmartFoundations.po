msgctxt "SmartFoundationsConfig,root/BuildingBehavior/bPreserveUpgradeDismantleGroups/display_name"
msgid "Preserve Upgrade Dismantle Groups"
msgstr "Zachowaj grupy demontażu przy ulepszaniu"

#: /SmartFoundations/SmartFoundations/Config/Smart_Config.Default__Smart_Config_C:BP_ConfigPropertySection_C_1.BP_ConfigPropertySection_C_3.BP_ConfigPropertyBool_C_5.Tooltip
msgctxt "SmartFoundationsConfig,root/BuildingBehavior/bPreserveUpgradeDismantleGroups/tooltip"
msgid "Default for preserving existing dismantle-group membership during Smart upgrades and supported downgrades. Can be overridden in the Upgrade panel."
msgstr "Domyślne zachowanie przynależności do istniejących grup demontażu podczas ulepszeń Smart i obsługiwanych degradacji. Można nadpisać w panelu Ulepsz."

