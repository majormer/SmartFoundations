msgctxt "SmartFoundations,Upgrade_AuditComplete"
msgid "Audit Complete: {0} upgradeable found across {1} structures."
msgstr "審計完成: 在 {1} 個結構中發現 {0} 個可升級項。"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/UI/SmartUpgradePanel.cpp(830)
