msgctxt "SmartFoundations,Upgrade_CostItems"
msgid "{0} items → Mk.{1}\n"
msgstr "{0} 項 → Mk.{1}\n"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/UI/SmartUpgradePanel_Detail.cpp(539)
msgctxt "SmartFoundations,Upgrade_CostUnavailable"
msgid "{0} × {1} Mk.{2} → Mk.{3}\n(Cost unavailable)"
msgstr "{0} × {1} Mk.{2} → Mk.{3}\n(所需材料不可用)"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/UI/SmartUpgradePanel.cpp(401)
msgctxt "SmartFoundations,Upgrade_CountColumn"
msgid "Count"
