msgid "Main Tier"
msgstr "Основной уровень"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(48)
msgctxt "SmartFoundations,P.PipeLevelMain.TT"
msgid "Pipe tier for the main connections. Auto uses the highest tier you've unlocked."
msgstr "Уровень труб для основных соединений. «Авто» использует наивысший открытый уровень."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(49)
