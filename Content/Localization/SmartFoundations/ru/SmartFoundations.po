msgid "Connections to Keep Free"
msgstr "Свободных подключений"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(78)
msgctxt "SmartFoundations,P.PowerConnectReserved.TT"
msgid "Number of pole connection slots to leave free for your own manual wiring."
msgstr "Число слотов подключения на столбе, оставляемых свободными для ручной прокладки проводов."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(133)
msgctxt "SmartFoundations,P.RotationIncrement"
msgid "Rotation Increment (deg)"
msgstr "Шаг вращения (°)"

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(134)
msgctxt "SmartFoundations,P.RotationIncrement.TT"
msgid "Degrees of rotation added per scroll notch (also walk segment turn)."
msgstr "Градусов вращения за один щелчок колеса (также поворот сегмента ходьбы)."

#: Mods/GameFeatures/SmartFoundations/Source/SmartFoundations/Private/Config/SmartFoundationsModConfiguration.cpp(127)
